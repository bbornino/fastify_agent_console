# Postgres
DATABASE_URL=postgresql://agent_console:agent_console_dev@localhost:5439/agent_console

# Redis
REDIS_URL=redis://localhost:6381

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=agent_console
MINIO_SECRET_KEY=agent_console_dev
MINIO_BUCKET=ticket-attachments

# MinIO container admin credentials (read directly by docker-compose.yml)
MINIO_ROOT_USER=agent_console
MINIO_ROOT_PASSWORD=agent_console_dev

# Mail (MailHog for local dev)
SMTP_HOST=localhost
SMTP_PORT=1026

# JWT secrets — generate real random values for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-real-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-real-random-secret
COOKIE_SECRET=replace-with-another-real-random-secret

# Google OAuth (from Google Cloud Console — see the OAuth client's Authorized redirect URIs)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback

# Frontend URL (used by the backend to build the OAuth redirect target)
FRONTEND_URL=http://localhost:4200
